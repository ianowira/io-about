{
  "name": "ian.owira.co.za",
  "version": "1.0.0",
  "description": "CV of Ian Owira",
  "main": "dist/index.html",
  "private": true,
  "targets": {
    "main": false
  },
  "scripts": {
    "parcel:serve": "parcel public/index.html",
    "parcel:build": "parcel build public/index.html",
    "ncp": "copyfiles ./public/sitemap.xml ./dist/sitemap.xml",
    "clean": "rimraf .parcel-cache .cache dist",
    "start": "npm-run-all -s clean parcel:serve",
    "build": "npm-run-all -s clean parcel:build ncp",
    "test": "vitest run",
    "commit": "cz",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "author": "Ian Owira",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@parcel/packager-raw-url": "2.16.4",
    "@parcel/transformer-webmanifest": "2.16.4",
    "@parcel/transformer-xml": "2.16.4",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "10.6.1",
    "commitizen": "4.3.2",
    "copyfiles": "2.4.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "npm-run-all": "4.1.5",
    "parcel": "2.16.4",
    "postcss": "8.5.28",
    "rimraf": "3.0.2",
    "tailwindcss": "4.3.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "alpinejs": "2.8.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@11.20.0"
}